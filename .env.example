# =====================================================================
# FollowLens — Backend
# Copie para `.env.local` (dev). Em produção configure na Vercel
# (Project Settings → Environment Variables). NUNCA versione valores reais.
# Gere segredos com: npm run secrets:generate
# =====================================================================

# === APP ===
NODE_ENV=development
PORT=4000
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=http://localhost:3000

# === DATABASE (Neon PostgreSQL) ===
# Use a connection string *pooled* do Neon (host com "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/followlens?sslmode=verify-full
DB_SSL=true
TYPEORM_LOGGING=false

# === AUTH (Google OAuth) ===
# Google Cloud Console → Credenciais → OAuth Client ID (Web)
GOOGLE_CLIENT_ID=
# E-mail do dono/self-host (libera o modo sessão owner-only). Vazio em deploy público.
OWNER_EMAIL=voce@email.com

# === SEGREDOS DE SERVIÇO ===
# Assina o token de sessão do painel (>= 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Chave compartilhada BFF (Next.js) -> backend. Mesma do frontend.
INTERNAL_API_KEY=
# Enviado pela Vercel Cron como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# === CONTA ===
# Dias entre o pedido de exclusão e a remoção definitiva da conta e dos dados
ACCOUNT_DELETION_GRACE_DAYS=7

# === INSTAGRAM (modo automático — opcional) ===
# Cookies da sessão: DevTools > Application > Cookies > https://www.instagram.com
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_USERNAME=
INSTAGRAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36
INSTAGRAM_APP_ID=936619743392459

# === TRAVAS DA SINCRONIZAÇÃO (modo automático) ===
SYNC_MANUAL_DAILY_LIMIT=1
SYNC_MIN_INTERVAL_MINUTES=60
SYNC_PAGE_SIZE=25
SYNC_PAGE_DELAY_MIN_MS=2000
SYNC_PAGE_DELAY_MAX_MS=5000
SYNC_TIME_BUDGET_MS=240000

# === IMPORTAÇÃO DO ARQUIVO DE EXPORTAÇÃO ===
IMPORT_DAILY_LIMIT=10
IMPORT_MAX_FILE_MB=4
# Proteção contra zip bomb: teto do conteúdo descompactado e nº de arquivos no .zip
IMPORT_MAX_UNZIPPED_MB=64
IMPORT_MAX_ZIP_ENTRIES=64
# Rejeita importações que perdem mais que esta fração de uma vez (arquivo errado)
IMPORT_MAX_LOSS_RATIO=0.3

# === EMAIL (Brevo) ===
BREVO_API_KEY=
MAIL_FROM_EMAIL=alertas@seudominio.com
MAIL_FROM_NAME=FollowLens
